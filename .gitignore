# Enviroment variables
.env
.env.local
.env.*.local
.env.production
.env.testing

# Logs
logs
*.log
# `logs` above is unanchored, so it matches any directory with that name at any
# depth -- including the source package added in Phase 8 at
# app/modules/security/infrastructure/logs/, which the commit would then have
# left out while every import of it stayed in. Anchoring the ignore to the
# repository root is what the rule meant: one runtime log directory.
# Re-include the package, and the re-inclusion needs the parent directory
# un-ignored too, because git does not descend into an excluded directory.
/logs/
!app/modules/security/infrastructure/logs/

# Cache
.cache
.pycache
__pycache__
*.py[cod]

# Database
*.sqlite3
db.sqlite3
.db

# User-uploaded artifacts. These are end-user content served back over
# GET /api/v1/software-management/storage/download/{storage_key}, not source.
# Tracking them puts arbitrary uploaded files (including .py) into version
# control.
#
# Anchored to the repository root. An unanchored ``storage/`` matches a
# directory of that name at *any* depth, which silently swallowed
# ``app/infrastructure/storage/`` -- so ``local_artifact_stager.py`` was never
# committed and a fresh clone could not import the application.
# ``app/infrastructure/storage/`` -- a source directory, not this one.
/storage/

# Codebase 
.vscode/
.idea/
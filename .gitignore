# Environment variables. A catch-all rather than a list of names: the earlier
# version enumerated .env.local, .env.production and .env.testing, so any new
# variant (.env.staging, .env.ci, .env.dev) was committable by omission.
# .env.example is the only env file that belongs in version control.
.env
.env.*
!.env.example
.envrc

# Logs. Anchored to the repository root: one runtime log directory, created on
# demand by app/core/logging_setup.py. An unanchored `logs` also matches
# app/modules/security/infrastructure/logs/, which is a source package -- that
# silently dropped it from the repo while every import of it stayed in.
/logs/
*.log

# Cache
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtualenvs. Listed explicitly instead of relying on the self-ignoring
# .gitignore that uv writes inside .venv/, so the exclusion is a property of
# this repository rather than of whichever tool happened to create the venv.
.venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/
__pypackages__/

# Database
*.sqlite3
*.db

# Certificates and private keys
*.pem
*.key
*.crt

# User-uploaded artifacts. These are end-user content served back over
# GET /api/v1/software-management/storage/download/{storage_key}, not source.
# Tracking them puts arbitrary uploaded files (including .py) into version
# control. Anchored to the repository root, because an unanchored `storage/`
# matches a directory of that name at any depth and silently swallowed the
# source package app/infrastructure/storage/.
/storage/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
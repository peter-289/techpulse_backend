# TechPulse configuration.
#
# ONE FILE, AT THE ROOT. Copy it to `.env` and edit that:
#
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore) and is excluded from the Docker build
# context (see .dockerignore), so real values stay out of both the repository
# and the image. `docker compose` reads it for `${...}` interpolation; the
# `api` and `migrate` services also receive it wholesale via `env_file`, which
# is how the application's own settings load.
#
# Everything the stack needs lives in this file, grouped by which container
# consumes it. Compose reads the whole file regardless of which services are
# active, so a variable belonging to a dev-profile service must still be
# defined here (or given a default with `${VAR:-...}` in docker-compose.yml)
# or interpolation fails before anything starts.
#
# ---------------------------------------------------------------------------
# 1. Backend application
# ---------------------------------------------------------------------------
# Read by app/core/config.py. Every name here must match a field there;
# anything else is silently dropped (SettingsConfigDict(extra="ignore")).

# development | staging | production | test
#   production  -> /docs, /redoc and /openapi.json are not served, the
#                  loopback CORS fallbacks are not added, and FRONTEND_URL must
#                  name a non-loopback origin or start-up fails.
ENVIRONMENT=development
# Overrides the environment's effect on the docs endpoints, either way.
SERVE_API_DOCS=true

# Two URLs because the application and Alembic use different drivers. Both must
# name the same database. An earlier DATABASE_URL matched neither field and was
# dropped without warning, which crashed the app on import.
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@db:5432/techpulse
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/techpulse

# At least 32 characters each, or start-up refuses. There is no default, so a
# deployment that forgets these fails immediately rather than signing tokens
# with an empty key.
SECRET_KEY=replace_with_at_least_32_random_characters
EMAIL_VERIFY_SECRET=replace_with_at_least_32_random_characters
PASSWORD_RESET_SECRET=replace_with_at_least_32_random_characters
ALGORITHM=HS256
LOGIN_TOKEN_EXPIRE_MINUTES=30
EMAIL_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_REQUIRE_SAME_USER_AGENT=true
REFRESH_REQUIRE_SAME_IP=false
EXPOSE_ACCESS_TOKEN_IN_BODY=false

# Reverse proxy. Only true when a proxy you control sits in front of the app
# AND strips inbound X-Forwarded-For / X-Real-IP from client requests.
# This one switch decides trust at both layers: docker-entrypoint.sh derives
# uvicorn's --proxy-headers flag from it, and refuses FORWARDED_ALLOW_IPS=*.
# See docs/adr/0015-proxy-header-trust-is-decided-in-one-place.md.
TRUST_PROXY_HEADERS=false
# Only read when TRUST_PROXY_HEADERS=true. Name the proxy's address, never "*".
FORWARDED_ALLOW_IPS=127.0.0.1

# Public URLs. FRONTEND_URL seeds the credentialed CORS allowlist, so in
# production it must be the real frontend origin.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
BASE_URL=http://127.0.0.1:8000

# Session cookies. COOKIE_SECURE is forced off if either URL above is http://,
# so a TLS deployment needs FRONTEND_URL and BACKEND_URL on https://.
ACCESS_COOKIE_NAME=tp_access
REFRESH_COOKIE_NAME=tp_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ACCESS_COOKIE_PATH=/
REFRESH_COOKIE_PATH=/api/v1/auth

# First superuser. Off by default: the earlier template shipped this enabled
# with a working password, which created an admin account anyone could log into.
# When enabling it, the password must be at least 12 characters and must not be
# a placeholder value such as "change_me"; start-up rejects both.
SUPERUSER_SEED_ENABLED=false
SUPERUSER_FULL_NAME=Admin User
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=
SUPERUSER_UPDATE_PASSWORD_ON_STARTUP=false

# Uploads. UPLOAD_ROOT and LOG_DIR are overridden to the mounted volume paths by
# the compose `api` service; set them only when running outside compose.
UPLOAD_ROOT=storage
PACKAGE_STORAGE_BACKEND=local
PACKAGE_UPLOAD_MAX_SIZE_BYTES=5368709120
PACKAGE_UPLOAD_CHUNK_SIZE_BYTES=1048576
PACKAGE_USER_QUOTA_BYTES=26843545600
PACKAGE_UPLOAD_RATE_LIMIT=30
PACKAGE_UPLOAD_RATE_WINDOW_SECONDS=60
PACKAGE_DOWNLOAD_RATE_LIMIT=120
PACKAGE_DOWNLOAD_RATE_WINDOW_SECONDS=60
STORAGE_DOWNLOAD_PATH=
URL_EXPIRY_MAX_SECONDS=900

# Database pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Logging and audit. LOG_DIR must be writable by the appuser that runs in the
# container; compose mounts a volume there.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_PATH=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
AUDIT_ENABLED=true
ALERT_LOGIN_FAILURE_THRESHOLD=5
ALERT_ACCESS_DENIED_THRESHOLD=10
ALERT_LOOKBACK_MINUTES=15
ALERT_DEDUP_MINUTES=15

# Auth abuse protection (IP rate limits)
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=60
AUTH_PASSWORD_RESET_REQUEST_RATE_LIMIT=5
AUTH_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=300
AUTH_PASSWORD_RESET_CONFIRM_RATE_LIMIT=10
AUTH_PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=300

# Background email verification recovery loop. Runs inside the web process, so
# with more than one replica it runs once per replica.
EMAIL_RECOVERY_ENABLED=true
EMAIL_RECOVERY_INTERVAL_SECONDS=120
EMAIL_RECOVERY_ELIGIBLE_AGE_SECONDS=120
EMAIL_RECOVERY_MAX_BATCH_SIZE=100
EMAIL_RECOVERY_MAX_RETRY_COUNT=20
EMAIL_RECOVERY_BACKOFF_BASE_SECONDS=120
EMAIL_RECOVERY_BACKOFF_MAX_SECONDS=3600
EMAIL_RECOVERY_STARTUP_DELAY_SECONDS=15
EMAIL_RETRY_MAX_ATTEMPTS=4
EMAIL_RETRY_BASE_DELAY_SECONDS=2
EMAIL_RETRY_MAX_DELAY_SECONDS=30

# Support chat AI. With AI_API_KEY unset the endpoint still answers, returning a
# canned reply, and /health stays green -- so set it or expect silent fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
SUPPORT_CHAT_MODEL=gpt-4o-mini
TRANSCRIPTION_BASE_URL=
WHISPER_MODEL=whisper-1

# Declared for completeness; no adapter reads these yet. PAYMENT_PROVIDER and
# MALWARE_SCAN_PROVIDER are validated at start-up and only accept "manual" and
# "local" respectively.
PAYMENT_PROVIDER=manual
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
MALWARE_SCAN_PROVIDER=local
MALWARE_SCAN_API_URL=
MALWARE_SCAN_API_KEY=

# ---------------------------------------------------------------------------
# 2. PostgreSQL  (consumed by the `db` container)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=techpulse
# Host-side bind port only; the container always listens on 5432.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# 3. Redis  (consumed by the `redis` container and the application)
# ---------------------------------------------------------------------------
# Required: `redis` runs with --requirepass and the api service connects with
# it. There is no anonymous mode.
REDIS_PASSWORD=change_this_redis_password
REDIS_DB=0
REDIS_USERNAME=
# Host-side bind port only. REDIS_HOST is overridden to `redis` by the compose
# api service; set it to localhost when running the app on the host.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# ---------------------------------------------------------------------------
# 4. Email
# ---------------------------------------------------------------------------
# Production will point these at a third-party provider. Mailhog is the local
# development sink and is only started by `--profile dev`; set SMTP_HOST=mailhog
# and leave the credentials empty when using it.
EMAIL_FROM=no-reply@techpulse.local
EMAIL_SUBJECT=Welcome to Tech Pulse
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_VALIDATE_CERTS=false

# ---------------------------------------------------------------------------
# 5. Host port bindings
# ---------------------------------------------------------------------------
# Host-side ports published by compose. Containers talk over the compose network
# by service name, so these only affect what is reachable from the host.
BACKEND_HOST_PORT=8000

# ---------------------------------------------------------------------------
# 6. Migrations
# ---------------------------------------------------------------------------
# Revision 8dea867ad60e permanently drops the projects, sms_purchases and
# sms_payments tables and refuses to run until this is set. Its downgrade()
# recreates the schema but not the rows. Take a backup, then set to 1.
TECHPULSE_ALLOW_DESTRUCTIVE_MIGRATIONS=0

# ---------------------------------------------------------------------------
# 7. Local development only  (`docker compose --profile dev`)
# ---------------------------------------------------------------------------
# Not needed in production. The `dev` profile does not start these services by
# default, but compose still interpolates the whole file, so the names must
# exist here or carry a default in docker-compose.yml.
MAILHOG_SMTP_HOST_PORT=1025
MAILHOG_UI_HOST_PORT=8025

PGADMIN_EMAIL=admin@example.com
# Never commit a real one. An earlier value was committed to git history.
PGADMIN_PASSWORD=
PGADMIN_HOST_PORT=5050